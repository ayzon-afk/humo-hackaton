PORT=5000
JWT_SECRET=change-me-before-deploy

# Коллекции для CRUD API (через запятую). Переименуй под тему: reports,places,orders
COLLECTIONS=items

# ---- AI (любой OpenAI-совместимый провайдер) ----
# Gemini:     AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  AI_MODEL=gemini-2.5-flash
# Groq:       AI_BASE_URL=https://api.groq.com/openai/v1                           AI_MODEL=llama-3.3-70b-versatile
# OpenAI:     AI_BASE_URL=https://api.openai.com/v1                                AI_MODEL=gpt-4o-mini
# OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1                             AI_MODEL=google/gemini-2.5-flash
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Модель для фото (если пусто — берётся AI_MODEL)
AI_VISION_MODEL=
AI_TIMEOUT_MS=20000

# ---- AI-агент: мониторинг и ежедневные отчёты ----
AGENT_ENABLED=true
AGENT_REPORT_TIME=09:00
AGENT_TZ=Asia/Tashkent
AGENT_CHECK_MINUTES=15
AGENT_STALE_HOURS=48
AGENT_DONE_STATUS=done
# Отчёты и срочные алерты в Telegram (необязательно)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
